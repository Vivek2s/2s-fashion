# --- API (apps/api) ---
PORT=4000
MONGODB_URI=mongodb://localhost:27017/fashion-store
CORS_ORIGIN=http://localhost:3000

# --- Web (apps/web) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Meta Pixel. Defaults to the live pixel if unset — point dev/staging at a test
# pixel (or a dummy ID) so local traffic doesn't pollute production reporting.
NEXT_PUBLIC_FB_PIXEL_ID=1006654455725122

# --- Studio (apps/web /studio — local image generation, server-side only) ---
# Needs access to the gpt-image-1 model (may require OpenAI org verification).
OPENAI_API_KEY=
