{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(npm run *)",
      "Bash(npm --workspace * run *)",
      "Bash(npx nx *)",
      "Bash(git status)", "Bash(git diff *)", "Bash(git add *)", "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
